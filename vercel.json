{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "roll-and-charge-website.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/our-services/mobile-tire-repair", "destination": "/services/flat-tire-repair/", "permanent": true },
    { "source": "/our-services/ev-repair", "destination": "/electric-vehicles/", "permanent": true },
    { "source": "/our-services/fleet-maintenance", "destination": "/services/fleet/", "permanent": true },
    { "source": "/our-services/mobile-oil-change", "destination": "/", "permanent": true },
    { "source": "/our-services/brake-repair", "destination": "/", "permanent": true },
    { "source": "/our-services", "destination": "/", "permanent": true },
    { "source": "/our-services-1", "destination": "/", "permanent": true },
    { "source": "/aboutus", "destination": "/about/", "permanent": true },
    { "source": "/contact", "destination": "/#booking", "permanent": true },
    { "source": "/warranty", "destination": "/policies/#warranty", "permanent": true },
    { "source": "/blog", "destination": "/winter-tires-ontario/", "permanent": true },
    { "source": "/post/:slug", "destination": "/winter-tires-ontario/", "permanent": true },
    { "source": "/privacy-policy", "destination": "/policies/#privacy", "permanent": false },
    { "source": "/terms-and-conditions", "destination": "/policies/#terms", "permanent": false },
    { "source": "/accessibility-statement", "destination": "/policies/#accessibility", "permanent": false },
    { "source": "/trademark-usage-policy", "destination": "/", "permanent": false }
  ]
}
